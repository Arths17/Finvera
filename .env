# Copy this file to `.env` and set a real DATABASE_URL for your environment.
# Example local Postgres URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/finvera"

# If using a hosted DB (Supabase/Neon/Railway), paste the provided connection URL here.

# Use the Docker container on port 5433 we create below
DATABASE_URL="file:./dev.db"

# NextAuth settings (optional)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace_with_a_secure_random_value
## keep NEXTAUTH settings below
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"